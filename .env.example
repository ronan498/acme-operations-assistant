# Copy to .env and fill in. Only OPENAI_API_KEY is a real secret;
# everything else has safe local-dev defaults baked into docker-compose.yml.

OPENAI_API_KEY=sk-proj-your-key-here

# Model chain (IDs verified against the live /v1/models)
PRIMARY_MODEL=gpt-5.6-sol
FALLBACK_MODELS=gpt-5.5,gpt-5.4

# Local-dev infrastructure credentials (defaults match docker-compose.yml)
POSTGRES_USER=acme
POSTGRES_PASSWORD=acme_dev_password
POSTGRES_DB=acme
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=master
